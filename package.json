{
  "name": "claude-quota-statusbar",
  "displayName": "%ext.displayName%",
  "description": "%ext.description%",
  "publisher": "Franky755",
  "version": "1.1.0",
  "license": "MIT",
  "icon": "images/icon.png",
  "author": {
    "name": "Tran Hiep (Franky755)",
    "url": "https://github.com/Franky755"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Franky755/claude-quota-statusbar.git"
  },
  "bugs": {
    "url": "https://github.com/Franky755/claude-quota-statusbar/issues"
  },
  "homepage": "https://github.com/Franky755/claude-quota-statusbar#readme",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "claude",
    "claude-code",
    "quota",
    "usage",
    "rate-limit",
    "statusbar",
    "usage-alert",
    "cost"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "claudeQuota.refresh",
        "title": "%cmd.refresh%"
      },
      {
        "command": "claudeQuota.showMenu",
        "title": "%cmd.showMenu%"
      },
      {
        "command": "claudeQuota.showLog",
        "title": "%cmd.showLog%"
      },
      {
        "command": "claudeQuota.manageAutoResume",
        "title": "%cmd.manageAutoResume%"
      }
    ],
    "configuration": {
      "title": "%cfg.title%",
      "properties": {
        "claudeQuota.language": {
          "type": "string",
          "enum": [
            "auto",
            "en",
            "vi",
            "zh-cn",
            "ja",
            "ko",
            "es",
            "pt-br",
            "fr",
            "de",
            "ru"
          ],
          "default": "auto",
          "enumDescriptions": [
            "%cfg.language.auto%",
            "English",
            "Tiếng Việt",
            "简体中文",
            "日本語",
            "한국어",
            "Español",
            "Português (Brasil)",
            "Français",
            "Deutsch",
            "Русский"
          ],
          "description": "%cfg.language.desc%"
        },
        "claudeQuota.showScopedOnStatusBar": {
          "type": "boolean",
          "default": false,
          "description": "%cfg.showScoped.desc%"
        },
        "claudeQuota.warningThreshold": {
          "type": "number",
          "default": 80,
          "minimum": 50,
          "maximum": 99,
          "description": "%cfg.warningThreshold.desc%"
        },
        "claudeQuota.errorThreshold": {
          "type": "number",
          "default": 95,
          "minimum": 60,
          "maximum": 100,
          "description": "%cfg.errorThreshold.desc%"
        },
        "claudeQuota.refreshIntervalSeconds": {
          "type": "number",
          "default": 60,
          "minimum": 30,
          "maximum": 600,
          "description": "%cfg.refreshInterval.desc%"
        },
        "claudeQuota.alignment": {
          "type": "string",
          "enum": [
            "right",
            "left"
          ],
          "default": "right",
          "description": "%cfg.alignment.desc%"
        },
        "claudeQuota.notifications": {
          "type": "boolean",
          "default": true,
          "description": "%cfg.notifications.desc%"
        },
        "claudeQuota.clickAction": {
          "type": "string",
          "enum": [
            "menu",
            "refresh"
          ],
          "default": "menu",
          "enumDescriptions": [
            "%cfg.clickAction.menu%",
            "%cfg.clickAction.refresh%"
          ],
          "description": "%cfg.clickAction.desc%"
        },
        "claudeQuota.statusBarFormat": {
          "type": "string",
          "default": "",
          "markdownDescription": "%cfg.statusBarFormat.desc%"
        },
        "claudeQuota.showCostEstimate": {
          "type": "boolean",
          "default": true,
          "description": "%cfg.showCostEstimate.desc%"
        },
        "claudeQuota.hideWhenSignedOut": {
          "type": "boolean",
          "default": false,
          "description": "%cfg.hideWhenSignedOut.desc%"
        },
        "claudeQuota.autoResume": {
          "type": "string",
          "enum": [
            "off",
            "selected",
            "all"
          ],
          "default": "selected",
          "enumDescriptions": [
            "%cfg.autoResume.off%",
            "%cfg.autoResume.selected%",
            "%cfg.autoResume.all%"
          ],
          "description": "%cfg.autoResume.desc%"
        },
        "claudeQuota.autoResumeMessage": {
          "type": "string",
          "default": "continue",
          "description": "%cfg.autoResumeMessage.desc%"
        },
        "claudeQuota.autoResumeDelaySeconds": {
          "type": "number",
          "default": 60,
          "minimum": 0,
          "maximum": 1800,
          "description": "%cfg.autoResumeDelay.desc%"
        }
      }
    }
  },
  "scripts": {
    "generate-icon": "node scripts/generate-icon.js",
    "check": "node --check extension.js",
    "test": "node test/extension.test.js",
    "package": "npx --yes @vscode/vsce package --no-dependencies",
    "publish:vsce": "npx --yes @vscode/vsce publish --no-dependencies",
    "publish:ovsx": "npx --yes ovsx publish",
    "screenshots": "node scripts/generate-screenshots.js"
  }
}
